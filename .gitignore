
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>صياد التجميع V9</title>
<style>
*{box-sizing:border-box}
body{margin:0;padding:12px;background:#07111e;color:#edf4ff;font-family:Arial;line-height:1.7}
h2{text-align:center;color:#00e6a0}
.card{background:#14243a;border:1px solid #2b405b;border-radius:13px;padding:13px;margin:12px 0}
input,select,button{width:100%;padding:12px;margin:5px 0;border-radius:8px;font-size:15px}
input,select{background:#091729;color:white;border:1px solid #435875}
button{background:#00d69a;color:#062018;border:0;font-weight:bold}
button.stop{background:#e65362;color:white}
button:disabled{opacity:.5}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.box{background:#091829;padding:9px;border-radius:8px;overflow-wrap:anywhere}
.box b{display:block;color:white;font-size:15px}
.green{color:#00e6a0}.red{color:#ff6878}.yellow{color:#ffd166}
.muted{color:#aabbd0;font-size:12px}
.tag{display:inline-block;background:#263d59;border-radius:20px;padding:3px 9px;font-size:12px;margin:2px}
.buycard{border-right:4px solid #00d69a}
.sellcard{border-right:4px solid #ff6878}
.waitcard{border-right:4px solid #e9b94c}
.progress{height:9px;background:#34455d;border-radius:9px;overflow:hidden}
.progress span{display:block;width:0;height:100%;background:#00d69a}
hr{border:0;border-top:1px solid #35475f;margin:12px 0}
</style>
</head>
<body>

<h2>🎯 صياد التجميع والانفجار V9</h2>
<p class="muted" style="text-align:center">اكتشاف التجميع من القاع قبل الانفجار المحتمل + صيد فرص الهبوط من القمم</p>

<div class="card">
<h3>🚀 ماسح العقود الآجلة</h3>
<p class="muted">عقود USDT الدائمة النشطة على Binance.</p>
<button id="start" onclick="startScan()">ابدأ صيد جميع العملات</button>
<button id="stop" class="stop" onclick="stopScan()" disabled>إيقاف الفحص</button>
<div class="progress"><span id="bar"></span></div>
<p id="progress" class="muted">جاهز</p>
</div>

<div class="card">
<h3>🔎 تحليل عملة محددة</h3>
<input id="coin" value="BTCUSDT" placeholder="مثال BTCUSDT">
<button onclick="analyzeOne()">تحليل العملة</button>
</div>

<div class="card">
<h3>تصفية الفرص</h3>
<select id="filter" onchange="render()">
<option value="ALL">كل النتائج</option>
<option value="BUY">تجميع من القاع - شراء</option>
<option value="SELL">استعداد هبوط - بيع</option>
<option value="EARLY">استعداد مبكر</option>
<option value="CONFIRMED">إشارات قوية</option>
<option value="WAIT">انتظار</option>
</select>
<div class="grid">
<div class="box">العقود المفحوصة<b id="total">0</b></div>
<div class="box">الفرص المكتشفة<b id="found">0</b></div>
</div>
</div>

<p id="status" class="yellow">الصياد جاهز</p>
<div id="results"></div>

<div class="card muted">
<b>مهم:</b> اكتشاف التجميع لا يعني ضمان الانفجار. القاع لا يمكن معرفته يقيناً قبل حدوث الحركة. درجات القوة توافق مؤشرات وليست احتمالات ربح. لا تدخل دون وقف خسارة.
</div>

<script>
"use strict";
const API="https://fapi.binance.com";
const $=id=>document.getElementById(id);
let running=false,cancelled=false,data=[];

const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const N=x=>Number(x)||0;
const fmt=x=>Number(x).toPrecision(7);
const avg=a=>a.length?a.reduce((s,v)=>s+v,0)/a.length:0;

async function get(path){
 const r=await fetch(API+path,{cache:"no-store"});
 if(!r.ok)throw Error("Binance HTTP "+r.status);
 return r.json();
}

function ema(a,n){
 if(a.length<n)return avg(a);
 let v=avg(a.slice(0,n)),k=2/(n+1);
 for(let i=n;i<a.length;i++)v=a[i]*k+v*(1-k);
 return v;
}

function rsi(a){
 if(a.length<15)return 50;
 let up=0,dn=0;
 for(let i=a.length-14;i<a.length;i++){
  let d=a[i]-a[i-1];
  if(d>0)up+=d;else dn-=d;
 }
 return dn===0?100:100-100/(1+(up/14)/(dn/14));
}

function makeStats(raw){
 const d=raw.slice(0,-1);
 const o=d.map(x=>N(x[1]));
 const h=d.map(x=>N(x[2]));
 const l=d.map(x=>N(x[3]));
 const c=d.map(x=>N(x[4]));
 const v=d.map(x=>N(x[5]));
 if(c.length<55)throw Error("شموع غير كافية");

 const tr=[];
 for(let i=1;i<c.length;i++){
  tr.push(Math.max(h[i]-l[i],Math.abs(h[i]-c[i-1]),Math.abs(l[i]-c[i-1])));
 }
 const atr=avg(tr.slice(-14))||c.at(-1)*.005;
 const p=c.at(-1);
 const e9=ema(c,9),e21=ema(c,21),e50=ema(c,50);
 const r=rsi(c);
 const resistance=Math.max(...h.slice(-21,-1));
 const support=Math.min(...l.slice(-21,-1));
 const high30=Math.max(...h.slice(-35,-5));
 const low30=Math.min(...l.slice(-35,-5));
 const highRecent=Math.max(...h.slice(-8,-1));
 const lowRecent=Math.min(...l.slice(-8,-1));

 const volAvg=avg(v.slice(-21,-1));
 const volRatio=v.at(-1)/(volAvg||1);
 const ranges=h.map((x,i)=>x-l[i]);
 const recentRange=avg(ranges.slice(-7,-1));
 const oldRange=avg(ranges.slice(-25,-7));
 const compressed=oldRange>0&&recentRange<oldRange*.82;

 const lows=l.slice(-8,-1);
 const highs=h.slice(-8,-1);
 const higherLows=avg(lows.slice(-3))>avg(lows.slice(0,3));
 const lowerHighs=avg(highs.slice(-3))<avg(highs.slice(0,3));

 const lastRange=Math.max(h.at(-1)-l.at(-1),p*.00001);
 const closePosition=(p-l.at(-1))/lastRange;
 const lowerWick=(Math.min(o.at(-1),p)-l.at(-1))/lastRange;
 const upperWick=(h.at(-1)-Math.max(o.at(-1),p))/lastRange;

 const trend=e9>e21&&e21>e50?1:e9<e21&&e21<e50?-1:0;
 const downFromHigh=(high30-p)/high30*100;
 const nearLow=(p-low30)/p*100;
 const nearSupport=(p-support)/p*100;
 const nearResistance=(resistance-p)/p*100;

 // الهبوط السابق والتوقف عن تسجيل قيعان جديدة
 const oldC=c.slice(-35,-12);
 const oldEma=ema(oldC,15);
 const priorDecline=oldEma>p*1.025;
 const stoppedFalling=lowRecent>=low30*.995;
 const recovering=r>38&&r<62&&r>rsi(c.slice(0,-5));
 const baseZone=nearLow<3.5||nearSupport<1.8;
 const demand=closePosition>.55||lowerWick>.28;

 const fakeUp=h.at(-1)>resistance&&p<resistance&&upperWick>.35;
 const fakeDown=l.at(-1)<support&&p>support&&lowerWick>.35;

 return {
  p,atr,e9,e21,e50,r,trend,resistance,support,high30,low30,
  highRecent,lowRecent,volRatio,compressed,higherLows,lowerHighs,
  closePosition,lowerWick,upperWick,downFromHigh,nearLow,
  nearSupport,nearResistance,priorDecline,stoppedFalling,
  recovering,baseZone,demand,fakeUp,fakeDown,
  highBreak:p>resistance,lowBreak:p<support
 };
}

function getPlan(m,side){
 const p=m.p,a=m.atr;
 let entry,stop,t1,t2,t3,trigger,invalidation;
 if(side==="BUY"){
  entry=Math.min(p,m.support+a*.25);
  trigger=m.highRecent+a*.12;
  stop=Math.min(m.low30-a*.25,entry-a*1.35);
  t1=Math.max(p+a*1.2,m.resistance);
  t2=p+a*2.2;
  t3=p+a*3.3;
  invalidation=m.low30;
 }else{
  entry=Math.max(p,m.resistance-a*.25);
  trigger=m.lowRecent-a*.12;
  stop=Math.max(m.high30+a*.25,entry+a*1.35);
  t1=Math.min(p-a*1.2,m.support);
  t2=p-a*2.2;
  t3=p-a*3.3;
  invalidation=m.high30;
 }
 const risk=Math.abs(entry-stop);
 return {
  entry,stop,t1,t2,t3,trigger,invalidation,
  rr:risk?Math.abs(t2-entry)/risk:0,
  move1:Math.abs(t1-p)/p*100,
  move2:Math.abs(t2-p)/p*100,
  move3:Math.abs(t3-p)/p*100
 };
}

function analyze(k5,k15,k1,k4,symbol){
 const a=makeStats(k5),b=makeStats(k15),c=makeStats(k1),d=makeStats(k4);
 let buy=0,sell=0,rb=[],rs=[];

 // نظام اكتشاف التجميع من القاع
 if(b.priorDecline){buy+=12;rb.push("هبوط سابق قبل منطقة التجميع");}
 if(b.baseZone){buy+=16;rb.push("السعر قريب من منطقة القاع والدعم");}
 if(b.stoppedFalling){buy+=14;rb.push("توقف تسجيل قيعان منخفضة جديدة");}
 if(b.higherLows){buy+=14;rb.push("ظهور قيعان أعلى تدريجياً");}
 if(b.compressed){buy+=12;rb.push("انكماش التذبذب واحتمال تجميع");}
 if(b.recovering){buy+=10;rb.push("تحسن الزخم من منطقة ضعيفة");}
 if(b.demand){buy+=10;rb.push("إغلاق الشمعة في النصف العلوي أو ذيل سفلي");}
 if(b.volRatio>1.15&&b.volRatio<3){buy+=8;rb.push("نشاط تداول أعلى من المتوسط");}
 if(c.trend>=0){buy+=6;rb.push("اتجاه الساعة لم يعد هابطاً بقوة");}
 if(b.fakeDown){buy+=10;rb.push("كسر دعم فاشل وعودة فوقه");}

 // نظام اكتشاف الهبوط من القمة
 if(b.lowerHighs){sell+=14;rs.push("قمم منخفضة متتالية");}
 if(b.trend===-1){sell+=16;rs.push("الاتجاه القصير هابط");}
 if(c.trend===-1){sell+=18;rs.push("اتجاه الساعة هابط");}
 if(d.trend===-1){sell+=15;rs.push("اتجاه الأربع ساعات هابط");}
 if(b.fakeUp){sell+=18;rs.push("اختراق مقاومة فاشل");}
 if(b.lowBreak){sell+=15;rs.push("كسر الدعم");}
 if(b.volRatio>1.3&&b.trend===-1){sell+=8;rs.push("نشاط بيع مرتفع");}

 // خصم عند استمرار الهبوط العنيف
 if(b.lowBreak&&b.r<30)buy-=18;
 if(b.nearLow>8&&!b.stoppedFalling)buy-=12;

 // الاتجاه العام
 const directionScore=b.trend+c.trend*2+d.trend*2;
 let state="عرضي / تجميع محتمل";
 if(b.fakeUp)state="صعود وهمي محتمل";
 else if(b.fakeDown)state="هبوط وهمي محتمل";
 else if(directionScore>=3)state="اتجاه صاعد";
 else if(directionScore<=-3)state="اتجاه هابط";
 else if(b.trend===1&&d.trend===-1)state="تصحيح صاعد داخل اتجاه هابط";
 else if(b.trend===-1&&d.trend===1)state="تصحيح هابط داخل اتجاه صاعد";

 let side="WAIT";
 // الشراء من التجميع لا يحتاج أن يكون الاتجاه الكبير صاعداً،
 // لكن يجب أن تتوقف القيعان عن الانخفاض وتظهر إشارات طلب.
 if(buy>=48&&buy>sell+5&&b.baseZone&&b.stoppedFalling)side="BUY";
 if(sell>=48&&sell>buy+5)side="SELL";

 let stage="انتظار";
 const score=Math.max(0,Math.min(100,Math.max(buy,sell)));
 if(side!=="WAIT"){
  stage=score>=78?"استعداد قوي":score>=62?"استعداد متقدم":"استعداد مبكر";
 }
 if(side==="BUY"&&b.priorDecline&&b.baseZone)stage="تجميع من القاع - قبل الانفجار المحتمل";
 if(side==="BUY"&&b.highBreak)stage="اختراق صاعد - الحركة بدأت";
 if(b.fakeUp||b.fakeDown)stage="حركة وهمية محتملة - حذر";

 const planSide=side==="SELL"?"SELL":"BUY";
 const plan=getPlan(b,planSide);
 const reasons=side==="BUY"?rb:side==="SELL"?rs:(buy>=sell?rb:rs);

 return {
  symbol,side,state,stage,score,buy,sell,reasons,plan,
  a,b,c,d
 };
}

function safe(s){
 return String(s).replace(/[&<>"']/g,x=>({
 "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
 }[x]));
}

function card(x){
 const p=x.plan,m=x.b;
 const cl=x.side==="BUY"?"buycard":x.side==="SELL"?"sellcard":"waitcard";
 const color=x.side==="BUY"?"green":x.side==="SELL"?"red":"yellow";
 const label=x.side==="BUY"?"شراء LONG":x.side==="SELL"?"بيع SHORT":"انتظار";
 const reasons=x.reasons.map(v=>"<li>"+safe(v)+"</li>").join("");
 const pctSign=x.side==="SELL"?"هبوط":"صعود";

 return `<div class="card ${cl}">
 <h3>${safe(x.symbol)}</h3>
 <span class="tag ${color}">${label}</span>
 <span class="tag">${safe(x.state)}</span>
 <span class="tag">${safe(x.stage)}</span>
 <div class="grid">
 <div class="box">السعر<b>${fmt(m.p)}</b></div>
 <div class="box">قوة الإشارة<b>${x.score}/100</b></div>
 <div class="box">قوة الشراء<b>${x.buy}</b></div>
 <div class="box">قوة البيع<b>${x.sell}</b></div>
 </div>
 <hr>
 <h3>🎯 منطقة الدخول</h3>
 <div class="grid">
 <div class="box">دخول مقترح<b>${fmt(p.entry)}</b></div>
 <div class="box">دخول بعد التأكيد<b>${fmt(p.trigger)}</b></div>
 <div class="box">وقف الخسارة<b class="red">${fmt(p.stop)}</b></div>
 <div class="box">إلغاء الفكرة<b>${fmt(p.invalidation)}</b></div>
 </div>
 <h3>الأهداف المتوقعة</h3>
 <div class="grid">
 <div class="box">الهدف الأول<b class="green">${fmt(p.t1)}</b><small>${pctSign} ${p.move1.toFixed(2)}%</small></div>
 <div class="box">الهدف الثاني<b class="green">${fmt(p.t2)}</b><small>${pctSign} ${p.move2.toFixed(2)}%</small></div>
 <div class="box">الهدف الثالث<b class="green">${fmt(p.t3)}</b><small>${pctSign} ${p.move3.toFixed(2)}%</small></div>
 <div class="box">العائد للمخاطرة<b>${p.rr.toFixed(2)} : 1</b></div>
 </div>
 <p class="muted">الأهداف تقديرية من ATR والمستويات السعرية، وليست توقعاً مضموناً.</p>
 <hr>
 <h3>قراءة التجميع والاتجاه</h3>
 <div class="grid">
 <div class="box">هبوط سابق<b>${m.priorDecline?"نعم":"غير واضح"}</b></div>
 <div class="box">قرب القاع<b>${m.baseZone?"نعم":"لا"}</b></div>
 <div class="box">توقف قيعان جديدة<b>${m.stoppedFalling?"نعم":"لا"}</b></div>
 <div class="box">قيعان أعلى<b>${m.higherLows?"نعم":"لا"}</b></div>
 <div class="box">انكماش التذبذب<b>${m.compressed?"نعم":"لا"}</b></div>
 <div class="box">RSI 15m<b>${m.r.toFixed(1)}</b></div>
 </div>
 <h3>الأطر الزمنية</h3>
 <div class="grid">
 <div class="box">5 دقائق<b>${x.a.trend===1?"صاعد":x.a.trend===-1?"هابط":"مختلط"}</b></div>
 <div class="box">15 دقيقة<b>${m.trend===1?"صاعد":m.trend===-1?"هابط":"مختلط"}</b></div>
 <div class="box">ساعة<b>${x.c.trend===1?"صاعد":x.c.trend===-1?"هابط":"مختلط"}</b></div>
 <div class="box">4 ساعات<b>${x.d.trend===1?"صاعد":x.d.trend===-1?"هابط":"مختلط"}</b></div>
 </div>
 <p>الحجم النسبي: ${m.volRatio.toFixed(2)}x | المقاومة: ${fmt(m.resistance)} | الدعم: ${fmt(m.support)}</p>
 <h3>أسباب الإشارة</h3><ul>${reasons||"<li>لا توجد إشارة واضحة</li>"}</ul>
 </div>`;
}

function render(){
 const f=$("filter").value;
 const list=data.filter(x=>{
  if(f==="BUY")return x.side==="BUY";
  if(f==="SELL")return x.side==="SELL";
  if(f==="WAIT")return x.side==="WAIT";
  if(f==="EARLY")return x.stage.includes("مبكر")||x.stage.includes("متقدم")||x.stage.includes("تجميع");
  if(f==="CONFIRMED")return x.stage==="استعداد قوي";
  return true;
 });
 $("found").textContent=data.filter(x=>x.side!=="WAIT").length;
 $("results").innerHTML=list.map(card).join("");
}

async function analyzeSymbol(symbol){
 const tfs=["5m","15m","1h","4h"];
 const ks=await Promise.all(tfs.map(tf=>
  get("/fapi/v1/klines?symbol="+symbol+"&interval="+tf+"&limit=100")
 ));
 return analyze(ks[0],ks[1],ks[2],ks[3],symbol);
}

async function analyzeOne(){
 if(running)return;
 const s=$("coin").value.trim().toUpperCase();
 if(!/^[A-Z0-9]{2,20}USDT$/.test(s)){
  $("status").textContent="اكتب رمزاً مثل BTCUSDT";return;
 }
 $("status").textContent="جاري تحليل "+s;
 try{
  const x=await analyzeSymbol(s);
  const i=data.findIndex(z=>z.symbol===s);
  if(i>=0)data[i]=x;else data.unshift(x);
  render();
  $("status").textContent="اكتمل تحليل "+s;
 }catch(e){$("status").textContent="تعذر التحليل: "+e.message;}
}

async function startScan(){
 if(running)return;
 running=true;cancelled=false;data=[];
 $("start").disabled=true;$("stop").disabled=false;
 $("results").innerHTML="";
 $("bar").style.width="0%";

 try{
  $("status").textContent="تحميل قائمة العقود...";
  const info=await get("/fapi/v1/exchangeInfo");
  const symbols=info.symbols.filter(s=>
   s.status==="TRADING"&&s.contractType==="PERPETUAL"&&s.quoteAsset==="USDT"
  );
  let next=0,done=0;
  $("total").textContent="0 / "+symbols.length;

  async function worker(){
   while(!cancelled){
    const i=next++;
    if(i>=symbols.length)return;
    const s=symbols[i];
    try{
     const x=await analyzeSymbol(s.symbol);
     data.push(x);
     data.sort((a,b)=>b.score-a.score);
     render();
    }catch(e){}
    done++;
    $("total").textContent=done+" / "+symbols.length;
    $("bar").style.width=(done/symbols.length*100)+"%";
    $("progress").textContent=done+" من "+symbols.length+
      " | فرص: "+data.filter(x=>x.side!=="WAIT").length;
    await sleep(160);
   }
  }

  await Promise.all([worker(),worker()]);
  render();
  $("status").textContent=cancelled?"تم إيقاف الفحص":"اكتمل الفحص";
 }catch(e){
  $("status").textContent="خطأ: "+e.message;
 }finally{
  running=false;
  $("start").disabled=false;$("stop").disabled=true;
 }
}

function stopScan(){
 cancelled=true;
 $("status").textContent="جاري إيقاف الفحص...";
}
</script>
</body>
</html>
