
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>صياد الانفجارات</title>
<style>
body{background:#101827;color:white;font-family:Arial;padding:15px}
h2{color:#00e6a0;text-align:center}
button{background:#00d69a;color:#071b16;border:0;padding:14px;border-radius:9px;font-size:17px;font-weight:bold;width:100%;margin:7px 0}
input{width:95%;padding:13px;border-radius:8px;font-size:17px;margin:8px 0}
.card{background:#1c293b;padding:14px;margin:12px 0;border-radius:10px;border-right:4px solid #00d69a}
.green{color:#00e6a0}
.red{color:#ff7777}
</style>
</head>
<body>

<h2>🎯 صياد الانفجارات</h2>
<p>Binance Futures - فريم 15 دقيقة</p>
<p>رأس المال: 100 دولار</p>

<h3>🔎 افحص أي عملة بالاسم</h3>
<input id="coin" placeholder="مثال BTCUSDT">
<button onclick="checkCoin()">افحص العملة الآن</button>

<hr>
<h3>🚀 صيد العملات</h3>
<button onclick="scan()">افحص أفضل 5 عملات</button>

<p id="status">جاهز للفحص</p>
<div id="results"></div>

<script>
const API="https://fapi.binance.com";

async function get(url){
 const r=await fetch(API+url);
 if(!r.ok)throw Error("الاتصال غير متاح");
 return r.json();
}

async function analyze(symbol){
 const k=await get("/fapi/v1/klines?symbol="+symbol+"&interval=15m&limit=30");
 if(k.length<25)throw Error("بيانات غير كافية");

 const candles=k.slice(0,-1);
 const last=candles[candles.length-1];
 const prev=candles.slice(-20);

 const close=+last[4];
 const open=+last[1];
 const high=+last[2];
 const low=+last[3];
 const volume=+last[5];

 const avgVol=prev.reduce((s,c)=>s+(+c[5]),0)/prev.length;
 const avgRange=prev.reduce((s,c)=>s+(+c[2]- +c[3])/(+c[4]),0)/prev.length;

 const change=(close-open)/open*100;
 const volRatio=volume/(avgVol||1);
 const quiet=avgRange<0.012;
 const breakout=volRatio>1.5&&Math.abs(change)>0.5;

 let score=0;
 if(quiet)score+=30;
 if(volRatio>1.5)score+=30;
 if(Math.abs(change)<1)score+=15;
 if(close>open)score+=15;
 if(breakout)score+=10;

 return {symbol,close,change,volRatio,quiet,breakout,score,high,low};
}

function show(c){
 const results=document.getElementById("results");
 results.innerHTML+=`
 <div class="card">
 <h3>${c.symbol}</h3>
 <p>السعر: ${c.close}</p>
 <p>التغير: ${c.change.toFixed(2)}%</p>
 <p>حجم التداول: ${c.volRatio.toFixed(2)} ضعف المتوسط</p>
 <p>الهدوء السابق: ${c.quiet?"نعم":"لا"}</p>
 <p>نشاط الاختراق: ${c.breakout?"مرتفع":"غير مؤكد"}</p>
 <p>أعلى سعر: ${c.high}</p>
 <p>أقل سعر: ${c.low}</p>
 <h3 class="green">قوة الترشيح: ${c.score}/100</h3>
 <p>${c.breakout?"حركة نشطة - راقب استمرار الاختراق":c.quiet?"عملة هادئة - راقب اقتراب الحركة":"لا توجد إشارة واضحة"}</p>
 <small>هذه قراءة استرشادية وليست توصية دخول.</small>
 </div>`;
}

async function checkCoin(){
 const symbol=document.getElementById("coin").value.trim().toUpperCase();
 const status=document.getElementById("status");
 document.getElementById("results").innerHTML="";
 if(!/^[A-Z0-9]{3,25}USDT$/.test(symbol)){
 status.innerText="اكتب اسم العملة مثل BTCUSDT";
 return;
 }
 status.innerText="⏳ جاري فحص العملة...";
 try{
 const c=await analyze(symbol);
 show(c);
 status.innerText="✅ انتهى الفحص";
 }catch(e){
 status.innerText="خطأ: تأكد من اسم العملة أو الاتصال";
 }
}

async function scan(){
 const status=document.getElementById("status");
 document.getElementById("results").innerHTML="";
 status.innerText="⏳ جاري فحص السوق...";
 try{
 const info=await get("/fapi/v1/exchangeInfo");
 const tickers=await get("/fapi/v1/ticker/24hr");
 const valid=new Set(info.symbols.filter(s=>
 s.status==="TRADING"&&
 s.quoteAsset==="USDT"&&
 s.contractType==="PERPETUAL"
 ).map(s=>s.symbol));

 const top=tickers.filter(t=>valid.has(t.symbol))
 .sort((a,b)=>Number(b.quoteVolume)-Number(a.quoteVolume))
 .slice(0,30);

 let found=[];
 for(let i=0;i<top.length;i+=5){
 const batch=await Promise.all(
 top.slice(i,i+5).map(t=>analyze(t.symbol).catch(()=>null))
 );
 found.push(...batch.filter(Boolean));
 }

 found.sort((a,b)=>b.score-a.score);
 found.slice(0,5).forEach(show);
 status.innerText=found.length?
 "✅ انتهى الفحص - أفضل 5 عملات":
 "لم تظهر نتائج";
 }catch(e){
 status.innerText="تعذر الاتصال بالسوق. حاول لاحقاً.";
 }
}
</script>
</body>
</html>
