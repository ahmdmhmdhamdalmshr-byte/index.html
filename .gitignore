
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>صياد الحيتان V19</title>
<style>
:root{--bg:#091323;--panel:#111e32;--line:#2a405f;--txt:#edf4ff;--muted:#91a5c2;--green:#20d6a0;--red:#ff647c;--gold:#ffc95d;--blue:#62b1ff}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(circle at 50% -20%,#20385c,#091323 50%);color:var(--txt);font-family:Tahoma,Arial;padding:10px}
.wrap{max-width:1100px;margin:auto}
header{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin:8px 0 15px}
h1{font-size:23px;margin:0}
.sub,.muted{font-size:12px;color:var(--muted)}
.pill{border:1px solid #31577f;border-radius:25px;padding:8px 12px;font-size:11px}
.panel,.coin,.stat{background:linear-gradient(145deg,#14223a,#0e192b);border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:11px}
h3{font-size:17px;margin:3px 0 14px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.stat span{font-size:11px;color:var(--muted)}
.stat b{display:block;font-size:21px;margin-top:8px}
.controls{display:grid;grid-template-columns:1fr 1fr;gap:8px}
input,select,button{min-width:0;width:100%;border-radius:10px;border:1px solid #354b6b;background:#0a1628;color:var(--txt);padding:12px;font:inherit}
button{cursor:pointer;background:#17385e;font-weight:bold}
button.primary{background:linear-gradient(90deg,#087d69,#126d9e);border:0}
button:disabled{opacity:.5}
.filters{display:flex;gap:7px;flex-wrap:wrap}
.filters button{width:auto;padding:9px 12px;font-size:12px}
.filters button.active{border-color:var(--blue);color:#b4dcff;background:#1b385b}
.bar{height:7px;background:#243650;border-radius:9px;overflow:hidden;margin:12px 0}
.bar i{display:block;width:0;height:100%;background:linear-gradient(90deg,#17c99a,#60b5ff)}
.status{font-size:12px;color:var(--muted);line-height:1.9}
.results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.coin{margin:0;min-width:0}
.head{display:flex;justify-content:space-between;align-items:center;gap:8px}
.symbol{font-size:21px;font-weight:bold;direction:ltr;text-align:right}
.price{font-size:15px;direction:ltr;text-align:right;margin-top:5px}
.tag{padding:7px 10px;border-radius:20px;font-size:11px;white-space:nowrap;background:#263650}
.green{background:#123e35;color:#6af0bd}
.red{background:#48202d;color:#ff9caf}
.gold{background:#43381e;color:#ffdc88}
.blue{background:#173958;color:#a5d5ff}
.decision{padding:13px;text-align:center;border-radius:11px;font-size:19px;font-weight:bold;margin:12px 0}
.decision.green{border:1px solid #168c69}
.decision.red{border:1px solid #a34259}
.decision.gold{border:1px solid #917537}
.confirm{padding:10px;border-radius:9px;text-align:center;font-size:12px;margin:8px 0}
.confirm.ok{background:#103b31;color:#72e9bd}
.confirm.wait{background:#41351e;color:#ffdc87}
.confirm.no{background:#43202b;color:#ff9bad}
.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:9px 0}
.metrics div{background:#0a1525;border-radius:8px;padding:9px;min-width:0}
.metrics small{display:block;color:var(--muted);font-size:10px;margin-bottom:6px}
.metrics b{font-size:12px;overflow-wrap:anywhere}
.scoreline{display:flex;justify-content:space-between;margin-top:12px;font-size:12px}
.meter{height:6px;background:#283a54;border-radius:9px;margin:7px 0 10px;overflow:hidden}
.meter i{display:block;height:100%;background:linear-gradient(90deg,#e5ad42,#1bd49c)}
.reason{font-size:11px;color:#b7c8df;line-height:1.9;border-top:1px solid #283b56;padding-top:8px}
.coin button{margin-top:9px}
.empty{text-align:center;padding:28px;color:var(--muted);border:1px dashed #354966;border-radius:12px;grid-column:1/-1}
.modal{display:none;position:fixed;inset:0;background:#000d;z-index:9;padding:10px;overflow:auto}
.modalbox{max-width:760px;margin:12px auto;background:#111e32;border:1px solid #3a5275;border-radius:16px;padding:15px}
.modalhead{display:flex;align-items:center;justify-content:space-between;gap:10px}
.modalhead button{width:auto;background:#442532}
.section{border-top:1px solid #2b405e;margin-top:14px;padding-top:10px}
.section h4{margin:4px 0 10px}
.tfrow{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}
.tfbox{background:#091525;border:1px solid #2c405e;padding:10px;border-radius:9px;text-align:center;font-size:12px}
.tfbox b{display:block;margin-top:8px}
.warning{font-size:11px;color:#ffd88c;line-height:1.9}
.goodtxt{color:var(--green)}.badtxt{color:var(--red)}
.smallbtn{width:auto;padding:7px 10px;font-size:11px}
footer{text-align:center;color:#788eac;font-size:11px;padding:16px}
@media(max-width:650px){
 .grid{grid-template-columns:repeat(2,1fr)}
 .results{grid-template-columns:1fr}
 .tfrow{grid-template-columns:repeat(2,1fr)}
}
</style>
</head>
<body>
<div class="wrap">

<header>
 <div>
  <h1>🐋 صياد الحيتان V19</h1>
  <div class="sub">الرصد المبكر • تدفق السيولة • كشف الانفجار والتصريف</div>
 </div>
 <div class="pill" id="connection">● جاري الاتصال</div>
</header>

<div class="grid">
 <div class="stat"><span>عقود USDT النشطة</span><b id="total">—</b></div>
 <div class="stat"><span>تم تحليلها</span><b id="scanned">0</b></div>
 <div class="stat"><span>عملات تتجهز</span><b id="preparing">0</b></div>
 <div class="stat"><span>انطلقت / تصريف</span><b id="moving">0</b></div>
</div>

<div class="panel">
 <h3>🔎 البحث والتحليل الفردي</h3>
 <div class="controls">
  <input id="search" placeholder="اكتب BTC أو SOL أو EVAA">
  <select id="tf">
   <option value="5m">5 دقائق</option>
   <option value="15m" selected>15 دقيقة</option>
   <option value="1h">ساعة</option>
   <option value="4h">4 ساعات</option>
  </select>
  <button class="primary" id="analyze">حلّل العملة</button>
  <button id="scan">ابدأ صيد جميع العقود</button>
 </div>
 <p class="warning">يفحص عقود Binance USDT الدائمة النشطة. العملات غير المدرجة في هذه العقود لن تظهر لها إشارة عقود آجلة.</p>
</div>

<div class="panel">
 <h3>🎯 تصنيف الصيد</h3>
 <div class="filters" id="filters">
  <button class="active" data-f="ALL">الكل</button>
  <button data-f="PRE">تتجهز</button>
  <button data-f="UP">انطلقت</button>
  <button data-f="FAKE">اختراق وهمي</button>
  <button data-f="DIST">تصريف</button>
  <button data-f="ENDUP">نهاية الصعود</button>
  <button data-f="ENDDOWN">نهاية الهبوط</button>
  <button data-f="SLEEP">نائمة</button>
 </div>
 <div class="bar"><i id="progress"></i></div>
 <div class="status" id="status">جاهز لبدء صيد السوق.</div>
</div>

<div class="panel">
 <h3>🚨 إنذارات الصياد</h3>
 <div id="alerts" class="status">لا توجد إنذارات بعد.</div>
 <button class="smallbtn" id="notify">تفعيل إشعارات الهاتف</button>
</div>

<div class="results" id="results">
 <div class="empty">ابدأ الصيد لمراقبة العقود.</div>
</div>

<div class="panel">
 <h3>🧠 كيف يصدر الصياد الإنذار؟</h3>
 <div class="warning">
  • التجميع: ضغط سعري ونطاق ضيق وتحسن القيعان مع تدفق شراء.<br>
  • الانطلاق: اختراق مستوى سعري مع ارتفاع الحجم وتأييد الصفقات.<br>
  • الاختراق الوهمي: تجاوز مستوى ثم العودة تحته مع ظهور ضغط بيع.<br>
  • التصريف: ضعف الطلب وتراجع القمم وظهور بيع عدواني.<br>
  • نهاية الحركة: تتطلب تأكيد انعكاس سعري، ولا تعتمد على القمة أو القاع وحدهما.
 </div>
</div>
</div>

<div class="modal" id="modal">
 <div class="modalbox">
  <div class="modalhead">
   <h3 id="mtitle">تقرير العملة</h3>
   <button id="close">إغلاق ✕</button>
  </div>
  <div id="mbody"></div>
 </div>
</div>

<footer>V19 • نتائج احتمالية مبنية على بيانات السوق وليست ضماناً للربح.</footer>

<script>
'use strict';

const API='https://fapi.binance.com';
const WS='wss://fstream.binance.com';
const $=id=>document.getElementById(id);

let universe=[];
let results=[];
let tickers={};
let liveData={};
let streams={};
let selected='ALL';
let scanning=false;
let mainSocket=null;
let monitorSocket=null;
let reconnectTimer=null;
let monitorTimer=null;
let lastAlert={};
let oiHistory={};
let previousStates={};

const fmt=n=>{
 n=Number(n);
 if(!Number.isFinite(n))return '—';
 if(Math.abs(n)>=1000)return n.toFixed(2);
 if(Math.abs(n)>=1)return n.toFixed(5);
 return n.toPrecision(6);
};

const avg=a=>a.length?a.reduce((s,x)=>s+x,0)/a.length:0;
const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));

async function api(path){
 const r=await fetch(API+path);
 if(!r.ok)throw Error('HTTP '+r.status);
 return r.json();
}

function normalizeSymbol(v){
 let s=String(v||'').toUpperCase().trim().replace(/[^A-Z0-9]/g,'');
 if(!s)throw Error('اكتب اسم العملة');
 return s.endsWith('USDT')?s:s+'USDT';
}

function ema(a,p){
 if(!a.length)return 0;
 const k=2/(p+1);
 let v=a[0];
 for(let i=1;i<a.length;i++)v=a[i]*k+v*(1-k);
 return v;
}

function rsi(a,p=14){
 if(a.length<p+1)return 50;
 let g=0,l=0;
 for(let i=a.length-p;i<a.length;i++){
  const d=a[i]-a[i-1];
  if(d>0)g+=d;else l-=d;
 }
 if(l===0)return 100;
 return 100-100/(1+g/l);
}

function median(a){
 if(!a.length)return 0;
 const s=[...a].sort((x,y)=>x-y);
 return s[Math.floor(s.length/2)];
}

function candleData(raw){
 return raw.map(x=>({
  time:+x[0],open:+x[1],high:+x[2],low:+x[3],
  close:+x[4],volume:+x[5],quote:+x[7],
  trades:+x[8],buyBase:+x[9],buyQuote:+x[10]
 }));
}

function getFlow(symbol){
 return liveData[symbol]||{
  buy:0,sell:0,buyCount:0,sellCount:0,
  bid:0,ask:0,imbalance:0,lastTrade:0
 };
}

function analyzeBars(symbol,raw,ticker,tf){
 const bars=candleData(raw);
 // الشمعة الحالية غير المغلقة لا تدخل في قرار التأكيد
 const b=bars.slice(0,-1);
 if(b.length<55)throw Error('شموع غير كافية');

 const c=b.map(x=>x.close);
 const h=b.map(x=>x.high);
 const l=b.map(x=>x.low);
 const v=b.map(x=>x.volume);
 const q=b.map(x=>x.quote);
 const last=b[b.length-1];

 const price=Number(ticker?.lastPrice)||last.close;
 const e9=ema(c.slice(-80),9);
 const e20=ema(c.slice(-100),20);
 const e50=ema(c.slice(-120),50);
 const rr=rsi(c);

 const priorHigh=Math.max(...h.slice(-21,-1));
 const priorLow=Math.min(...l.slice(-21,-1));
 const rangeHigh=Math.max(...h.slice(-24));
 const rangeLow=Math.min(...l.slice(-24));

 const oldHigh=Math.max(...h.slice(-48,-24));
 const oldLow=Math.min(...l.slice(-48,-24));

 const avgVol=avg(v.slice(-21,-1));
 const volRatio=last.volume/Math.max(avgVol,0.000000001);
 const avgQuote=avg(q.slice(-21,-1));
 const quoteRatio=last.quote/Math.max(avgQuote,0.000000001);

 const flow=getFlow(symbol);
 const totalFlow=flow.buy+flow.sell;
 const takerRatio=totalFlow>0?flow.buy/totalFlow:
  last.buyBase/Math.max(last.volume,0.000000001);

 const depthTotal=flow.bid+flow.ask;
 const depthRatio=depthTotal>0?flow.bid/depthTotal:.5;
 const imbalance=flow.imbalance||0;

 const candleRange=Math.max(last.high-last.low,price*.000001);
 const upperWick=(last.high-Math.max(last.open,last.close))/candleRange;
 const lowerWick=(Math.min(last.open,last.close)-last.low)/candleRange;

 const atrs=[];
 for(let i=Math.max(1,b.length-15);i<b.length;i++){
  atrs.push(Math.max(
   h[i]-l[i],
   Math.abs(h[i]-c[i-1]),
   Math.abs(l[i]-c[i-1])
  ));
 }
 const atr=avg(atrs);
 const atrPct=atr/price*100;

 const rangePct=(rangeHigh-rangeLow)/price*100;
 const nearLow=(price-rangeLow)/price*100;
 const nearHigh=(rangeHigh-price)/price*100;

 const risingLows=l.slice(-8).filter((x,i,a)=>i>0&&x>a[i-1]).length;
 const fallingHighs=h.slice(-8).filter((x,i,a)=>i>0&&x<a[i-1]).length;
 const higherLow=rangeLow>oldLow*1.001;
 const lowerHigh=rangeHigh<oldHigh*.999;

 const compressed=rangePct<Math.max(4,atrPct*5);
 const trendUp=e9>e20&&e20>e50;
 const trendDown=e9<e20&&e20<e50;

 const breakout=last.close>priorHigh*1.001&&
  volRatio>1.25&&takerRatio>.54;
 const breakdown=last.close<priorLow*.999&&
  volRatio>1.25&&takerRatio<.46;

 const fakeBreak=last.high>priorHigh*1.002&&
  last.close<priorHigh&&upperWick>.35&&takerRatio<.53;
 const fakeBreakDown=last.low<priorLow*.998&&
  last.close>priorLow&&lowerWick>.35&&takerRatio>.50;

 const flowBuy=totalFlow>0&&takerRatio>.57;
 const flowSell=totalFlow>0&&takerRatio<.43;
 const depthBuy=depthRatio>.57;
 const depthSell=depthRatio<.43;

 let buy=0,sell=0;
 const reasons=[];

 // إشارات التجميع المبكر
 if(compressed)buy+=8;
 if(nearLow<4)buy+=8;
 if(higherLow)buy+=10;
 if(risingLows>=3)buy+=8;
 if(takerRatio>.53)buy+=8;
 if(flowBuy)buy+=12;
 if(depthBuy)buy+=9;
 if(volRatio>1.2&&takerRatio>.52)buy+=8;
 if(trendUp)buy+=8;
 if(fakeBreakDown)buy+=12;
 if(breakout)buy+=25;

 // إشارات التصريف والهبوط
 if(compressed)sell+=7;
 if(nearHigh<4)sell+=8;
 if(lowerHigh)sell+=10;
 if(fallingHighs>=3)sell+=8;
 if(takerRatio<.47)sell+=8;
 if(flowSell)sell+=12;
 if(depthSell)sell+=9;
 if(volRatio>1.2&&takerRatio<.48)sell+=8;
 if(trendDown)sell+=8;
 if(fakeBreak)sell+=15;
 if(breakdown)sell+=25;

 if(trendDown)buy-=12;
 if(trendUp)sell-=12;

 buy=clamp(buy,0,100);
 sell=clamp(sell,0,100);

 const previous=previousStates[symbol]||{};
 const bearishReversal=price<e20&&last.close<priorLow&&
  rr<48&&takerRatio<.48;
 const bullishReversal=price>e20&&last.close>priorHigh&&
  rr>45&&takerRatio>.52;

 let state='SLEEP',side='WAIT',confirmed=false;
 let decision='انتظار';
 let confidence=Math.max(buy,sell);

 if(fakeBreak){
  state='FAKE';side='SHORT';decision='اختراق صاعد وهمي';
  reasons.push('رفض سعري من أعلى النطاق');
 }
 else if(breakdown&&sell>=45){
  state='DOWN';side='SHORT';confirmed=true;
  decision='دخول بيع مؤكد فنياً';
  reasons.push('كسر الدعم بإغلاق وحجم وضغط بيع');
 }
 else if(breakout&&buy>=45){
  state='UP';side='LONG';confirmed=true;
  decision='دخول شراء مؤكد فنياً';
  reasons.push('اختراق المقاومة بإغلاق وحجم وضغط شراء');
 }
 else if(bearishReversal){
  state='ENDUP';side='SHORT';confirmed=true;
  decision='نهاية الصعود مؤكدة فنياً';
  reasons.push('كسر دعم بعد ضعف الزخم');
 }
 else if(bullishReversal){
  state='ENDDOWN';side='LONG';confirmed=true;
  decision='نهاية الهبوط مؤكدة فنياً';
  reasons.push('استعادة مقاومة بعد ارتداد');
 }
 else if(compressed&&nearLow<5&&buy>=40&&buy>sell&&
  (higherLow||flowBuy||depthBuy)){
  state='PRE';side='LONG';decision='عملة تتجهز لصعود محتمل';
  reasons.push('ضغط سعري قرب القاع');
  reasons.push('علامات تجميع مبكر');
 }
 else if(compressed&&nearHigh<5&&sell>=40&&sell>buy&&
  (lowerHigh||flowSell||depthSell)){
  state='DIST';side='SHORT';decision='تصريف محتمل قبل الهبوط';
  reasons.push('ضعف الطلب قرب القمة');
 }
 else if(nearHigh<3&&rr>75&&upperWick>.35){
  state='EXHAUST';side='WAIT';decision='إنهاك صعود — راقب التصريف';
 }
 else if(nearLow<3&&rr<25&&lowerWick>.35){
  state='EXHAUSTDOWN';side='WAIT';decision='إنهاك هبوط — راقب الارتداد';
 }
 else if(trendUp){
  state='TRENDUP';side='LONG';decision='اتجاه صاعد مستمر';
 }
 else if(trendDown){
  state='TRENDDOWN';side='SHORT';decision='اتجاه هابط مستمر';
 }

 if(higherLow)reasons.push('القيعان تتحسن');
 if(lowerHigh)reasons.push('القمم تتناقص');
 if(flowBuy)reasons.push('تدفق صفقات شراء قوي');
 if(flowSell)reasons.push('تدفق صفقات بيع قوي');
 if(depthBuy)reasons.push('دفتر الأوامر يميل للشراء');
 if(depthSell)reasons.push('دفتر الأوامر يميل للبيع');
 if(volRatio>1.3)reasons.push('حجم التداول أعلى من المتوسط');
 if(fakeBreakDown)reasons.push('رفض كسر هابط');
 if(rr>70)reasons.push('RSI مرتفع');
 if(rr<30)reasons.push('RSI منخفض');

 const resistance=priorHigh;
 const support=priorLow;
 const topTarget=Math.max(rangeHigh,resistance)+atr*1.5;
 const bottomTarget=Math.max(price*.001,Math.min(rangeLow,support)-atr*1.5);

 let entry=price,stop=0,t1=0,t2=0,t3=0;
 if(side==='LONG'){
  entry=breakout?resistance:price;
  stop=Math.min(support,entry-atr*1.3);
  const risk=Math.max(entry-stop,atr);
  t1=entry+risk*1.5;t2=entry+risk*2.5;t3=entry+risk*3.5;
 }else if(side==='SHORT'){
  entry=breakdown?support:price;
  stop=Math.max(resistance,entry+atr*1.3);
  const risk=Math.max(stop-entry,atr);
  t1=entry-risk*1.5;t2=entry-risk*2.5;t3=entry-risk*3.5;
 }

 const change=Number(ticker?.priceChangePercent)||0;

 return {
  symbol,price,tf,side,state,decision,confirmed,confidence,buy,sell,
  rr,volRatio,quoteRatio,takerRatio,depthRatio,imbalance,
  atrPct,rangePct,nearLow,nearHigh,compressed,
  resistance,support,topTarget,bottomTarget,
  entry,stop,t1,t2,t3,change,reasons,
  flowBuy,flowSell,depthBuy,depthSell,breakout,breakdown,
  fakeBreak,bullishReversal,bearishReversal,
  time:Date.now()
 };
}

function stateName(s){
 return ({
  PRE:'تتجهز',UP:'انطلقت',FAKE:'اختراق وهمي',
  DIST:'تصريف',ENDUP:'نهاية الصعود',
  ENDDOWN:'نهاية الهبوط',SLEEP:'نائمة',
  EXHAUST:'إنهاك الصعود',EXHAUSTDOWN:'إنهاك الهبوط',
  TRENDUP:'اتجاه صاعد',TRENDDOWN:'اتجاه هابط',
  DOWN:'كسر هابط'
 })[s]||s;
}
function stateClass(s){
 if(['PRE','UP','ENDDOWN','TRENDUP'].includes(s))return 'green';
 if(['FAKE','DIST','ENDUP','DOWN','TRENDDOWN'].includes(s))return 'red';
 if(['EXHAUST','EXHAUSTDOWN'].includes(s))return 'gold';
 return 'blue';
}
function priceColor(n){
 return n>=0?'#20d6a0':'#ff647c';
}

function updateStats(){
 $('scanned').textContent=results.length;
 $('preparing').textContent=results.filter(x=>x.state==='PRE').length;
 $('moving').textContent=results.filter(x=>['UP','DIST','ENDUP','DOWN'].includes(x.state)).length;
}

function render(){
 let a=results.filter(r=>{
  if(selected==='ALL')return true;
  if(selected==='PRE')return r.state==='PRE';
  if(selected==='UP')return r.state==='UP';
  if(selected==='FAKE')return r.state==='FAKE';
  if(selected==='DIST')return r.state==='DIST';
  if(selected==='ENDUP')return r.state==='ENDUP';
  if(selected==='ENDDOWN')return r.state==='ENDDOWN';
  if(selected==='SLEEP')return r.state==='SLEEP';
  return true;
 });
 a.sort((x,y)=>y.confidence-x.confidence);
 $('results').innerHTML=a.length?a.map(card).join(''):
 '<div class="empty">لا توجد عملات في هذا التصنيف حالياً.</div>';
 updateStats();
}

function card(r){
 const cls=stateClass(r.state);
 const sideText=r.side==='LONG'?'شراء LONG':
 r.side==='SHORT'?'بيع SHORT':'انتظار';
 const confirmation=r.confirmed?
 '<div class="confirm ok">✓ شروط الدخول تحققت وفق النموذج</div>':
 '<div class="confirm wait">◷ إنذار مراقبة — الدخول غير مؤكد</div>';

 return `<div class="coin">
 <div class="head">
  <div>
   <div class="symbol">${r.symbol}</div>
   <div class="price" id="p-${r.symbol}">${fmt(r.price)} USDT</div>
  </div>
  <span class="tag ${cls}">${stateName(r.state)}</span>
 </div>
 <div class="decision ${cls}">${sideText}</div>
 ${confirmation}
 <div style="text-align:center;font-size:13px">${r.decision}</div>
 <div class="scoreline"><span>قوة الأدلة الفنية</span><b>${r.confidence}/100</b></div>
 <div class="meter"><i style="width:${r.confidence}%"></i></div>
 <div class="metrics">
  <div><small>السعر المباشر</small><b>${fmt(r.price)}</b></div>
  <div><small>تغير 24 ساعة</small><b style="color:${priceColor(r.change)}">${r.change.toFixed(2)}%</b></div>
  <div><small>ضغط الشراء</small><b>${(r.takerRatio*100).toFixed(1)}%</b></div>
 </div>
 <div class="metrics">
  <div><small>منطقة الدخول</small><b>${fmt(r.entry)}</b></div>
  <div><small>وقف الخسارة</small><b>${fmt(r.stop)}</b></div>
  <div><small>الهدف الأول</small><b>${fmt(r.t1)}</b></div>
 </div>
 <div class="reason">${r.reasons.slice(0,4).join(' • ')||'لا توجد إشارات قوية'}</div>
 <button onclick="openReport('${r.symbol}')">كشف الحيتان والتقرير الكامل</button>
 </div>`;
}

function addAlert(r){
 const key=r.symbol+'_'+r.state;
 if(lastAlert[key]&&Date.now()-lastAlert[key]<600000)return;
 lastAlert[key]=Date.now();
 const line=`<div style="padding:7px;border-bottom:1px solid #2a3c56">
 <b>${r.symbol}</b> — ${stateName(r.state)} — ${r.decision}
 <small style="color:#9aabc2"> ${new Date().toLocaleTimeString('ar')}</small>
 </div>`;
 $('alerts').innerHTML=line+$('alerts').innerHTML;
 if('Notification'in window&&Notification.permission==='granted'){
  new Notification('🐋 صياد الحيتان: '+r.symbol,{body:r.decision+' — '+stateName(r.state)});
 }
}

function checkTransition(r){
 const old=previousStates[r.symbol];
 if(old&&old!==r.state&&
 ['PRE','UP','FAKE','DIST','ENDUP','ENDDOWN'].includes(r.state)){
  addAlert(r);
 }
 previousStates[r.symbol]=r.state;
}

async function loadUniverse(){
 const x=await api('/fapi/v1/exchangeInfo');
 universe=x.symbols
  .filter(s=>s.contractType==='PERPETUAL'&&
  s.quoteAsset==='USDT'&&s.status==='TRADING')
  .map(s=>s.symbol);
 $('total').textContent=universe.length;
}

function startTickerSocket(){
 try{
  if(mainSocket)mainSocket.close();
  mainSocket=new WebSocket(WS+'/ws/!ticker@arr');
  mainSocket.onopen=()=>{
   $('connection').textContent='● بث السعر المباشر يعمل';
   $('connection').style.color='#20d6a0';
  };
  mainSocket.onmessage=e=>{
   const data=JSON.parse(e.data);
   if(!Array.isArray(data))return;
   for(const t of data){
    tickers[t.s]={
     lastPrice:+t.c,
     priceChangePercent:+t.P,
     quoteVolume:+t.q
    };
    const p=$('p-'+t.s);
    if(p){
     p.innerHTML=fmt(t.c)+' USDT <span style="color:'+priceColor(+t.P)+'">'+(+t.P).toFixed(2)+'%</span>';
     const r=results.find(x=>x.symbol===t.s);
     if(r)r.price=+t.c;
    }
   }
  };
  mainSocket.onclose=()=>{
   $('connection').textContent='● إعادة الاتصال بالبث';
   $('connection').style.color='#ffc95d';
   clearTimeout(reconnectTimer);
   reconnectTimer=setTimeout(startTickerSocket,4000);
  };
  mainSocket.onerror=()=>{try{mainSocket.close()}catch(e){}};
 }catch(e){}
}

// يخصص بث الصفقات ودفتر الأوامر لأفضل المرشحين فقط
function startCandidateSocket(){
 if(monitorSocket)try{monitorSocket.close()}catch(e){}
 const candidates=results
  .filter(r=>['PRE','UP','DIST','FAKE','ENDUP','ENDDOWN'].includes(r.state))
  .sort((a,b)=>b.confidence-a.confidence)
  .slice(0,25);
 const names=[...new Set(candidates.map(r=>r.symbol.toLowerCase()))];
 if(!names.length)return;
 const streams=[];
 names.forEach(s=>{
  streams.push(s+'@aggTrade');
  streams.push(s+'@depth20@100ms');
 });
 const url=WS+'/stream?streams='+streams.join('/');
 try{
  monitorSocket=new WebSocket(url);
  monitorSocket.onmessage=e=>{
   const packet=JSON.parse(e.data);
   const d=packet.data;
   if(!d)return;
   const s=d.s;
   if(!s)return;
   if(!liveData[s]){
    liveData[s]={buy:0,sell:0,buyCount:0,sellCount:0,bid:0,ask:0,imbalance:0,lastTrade:0};
   }
   const x=liveData[s];
   if(d.e==='aggTrade'){
    const quote=Number(d.p)*Number(d.q);
    if(d.m){x.sell+=quote;x.sellCount++}
    else{x.buy+=quote;x.buyCount++}
    x.lastTrade=Date.now();
    // حجم متحرك تقريبي: إعادة ضبط كل دقيقة
    if(!x.resetAt||Date.now()-x.resetAt>60000){
     x.buy=0;x.sell=0;x.buyCount=0;x.sellCount=0;
     x.resetAt=Date.now();
    }
   }
   if(d.e==='depthUpdate'){
    const bids=d.b||[];
    const asks=d.a||[];
    x.bid=bids.reduce((s,z)=>s+(+z[0])*(+z[1]),0);
    x.ask=asks.reduce((s,z)=>s+(+z[0])*(+z[1]),0);
    x.imbalance=(x.bid-x.ask)/Math.max(1,x.bid+x.ask);
   }
  };
 }catch(e){}
}

async function scanOne(s,tf){
 s=normalizeSymbol(s);
 if(!universe.includes(s))throw Error('هذا الرمز ليس عقد USDT دائم نشطاً في Binance Futures');
 const [bars,ticker]=await Promise.all([
  api('/fapi/v1/klines?symbol='+s+'&interval='+tf+'&limit=120'),
  api('/fapi/v1/ticker/24hr?symbol='+s)
 ]);
 tickers[s]={lastPrice:+ticker.lastPrice,priceChangePercent:+ticker.priceChangePercent,quoteVolume:+ticker.quoteVolume};
 return analyzeBars(s,bars,ticker,tf);
}

async function scanMarket(){
 if(scanning)return;
 scanning=true;
 $('scan').disabled=true;
 $('status').textContent='تحميل جميع عقود USDT الدائمة…';
 $('progress').style.width='1%';
 try{
  if(!universe.length)await loadUniverse();

  // اختيار السيولة الأعلى للفحص العميق أولاً، مع إظهار عدد العقود الكلي
  const tick=await api('/fapi/v1/ticker/24hr');
  const map=new Map(tick.map(t=>[t.symbol,t]));
  const ordered=[...universe].sort((a,b)=>
   (+map.get(b)?.quoteVolume||0)-(+map.get(a)?.quoteVolume||0));

  results=[];
  $('status').textContent='فحص '+ordered.length+' عقداً حسب السيولة…';
  let done=0,failed=0;
  let index=0;
  const workers=Array.from({length:7},async()=>{
   while(index<ordered.length){
    const s=ordered[index++];
    try{
     const [bars]=await Promise.all([
      api('/fapi/v1/klines?symbol='+s+'&interval=15m&limit=100')
     ]);
     const t=map.get(s)||{};
     const r=analyzeBars(s,bars,{
      lastPrice:+t.lastPrice,
      priceChangePercent:+t.priceChangePercent
     },'15m');
     results.push(r);
     checkTransition(r);
    }catch(e){failed++}
    done++;
    if(done%10===0||done===ordered.length){
     $('progress').style.width=(done/ordered.length*100)+'%';
     $('status').textContent=`تحليل ${done}/${ordered.length} — تعذر ${failed}`;
     render();
    }
   }
  });
  await Promise.all(workers);
  render();
  startCandidateSocket();
  $('status').textContent=`انتهى الفحص: ${done} عقداً. تعذر تحليل ${failed}. السعر المباشر مستمر.`;
 }catch(e){
  $('status').textContent='خطأ: '+e.message;
 }finally{
  scanning=false;
  $('scan').disabled=false;
 }
}

async function openReport(symbol){
 const r=results.find(x=>x.symbol===symbol);
 if(!r)return;
 $('modal').style.display='block';
 $('mtitle').textContent='🐋 تقرير '+symbol;
 $('mbody').innerHTML='<p class="status">جاري تحليل الفريمات والبيانات…</p>';

 const frames=['5m','15m','1h','4h'];
 const reports=[];
 for(const tf of frames){
  try{reports.push(await scanOne(symbol,tf))}
  catch(e){reports.push({tf,error:e.message})}
 }
 const valid=reports.filter(x=>!x.error);
 const longs=valid.filter(x=>x.side==='LONG').length;
 const shorts=valid.filter(x=>x.side==='SHORT').length;
 const flow=getFlow(symbol);
 const total=flow.buy+flow.sell;
 const ratio=total?flow.buy/total:0;

 const frameHTML=reports.map(x=>x.error?
 `<div class="tfbox">${x.tf}<b class="badtxt">غير متاح</b></div>`:
 `<div class="tfbox">${x.tf}<b class="${x.side==='LONG'?'goodtxt':x.side==='SHORT'?'badtxt':''}">${x.side==='LONG'?'شراء':x.side==='SHORT'?'بيع':'انتظار'}</b><small>${x.confidence}/100</small></div>`
 ).join('');

 const agree=longs>=3?'الفريمات تميل للصعود':
 shorts>=3?'الفريمات تميل للهبوط':
 'لا يوجد توافق واضح بين الفريمات';

 $('mbody').innerHTML=`
 <div class="decision ${stateClass(r.state)}">${stateName(r.state)} — ${r.decision}</div>
 <div class="confirm ${r.confirmed?'ok':'wait'}">${r.confirmed?'✓ شروط الإشارة تحققت فنياً':'◷ إنذار مراقبة — لم يكتمل تأكيد الدخول'}</div>

 <div class="section"><h4>📊 توافق الفريمات</h4>
 <div class="tfrow">${frameHTML}</div>
 <p class="warning">${agree}. اختلاف الفريمات يرفع خطر الإشارة.</p></div>

 <div class="section"><h4>🐋 تدفق الصفقات ودفتر الأوامر</h4>
 <div class="metrics">
  <div><small>شراء عدواني</small><b>${fmt(flow.buy)} USDT</b></div>
  <div><small>بيع عدواني</small><b>${fmt(flow.sell)} USDT</b></div>
  <div><small>نسبة الشراء</small><b>${(ratio*100).toFixed(1)}%</b></div>
 </div>
 <div class="metrics">
  <div><small>سيولة الطلبات الشرائية</small><b>${fmt(flow.bid)}</b></div>
  <div><small>سيولة الطلبات البيعية</small><b>${fmt(flow.ask)}</b></div>
  <div><small>اختلال الدفتر</small><b>${(flow.imbalance*100).toFixed(1)}%</b></div>
 </div>
 <p class="warning">دفتر الأوامر يعرض السيولة الظاهرة فقط؛ قد تسحب الأوامر أو تتغير ولا يثبت وحده وجود حوت.</p></div>

 <div class="section"><h4>🎯 الدخول والخروج</h4>
 <div class="metrics">
  <div><small>منطقة الدخول المرجعية</small><b>${fmt(r.entry)}</b></div>
  <div><small>وقف الخسارة</small><b>${fmt(r.stop)}</b></div>
  <div><small>الهدف الأول</small><b>${fmt(r.t1)}</b></div>
 </div>
 <div class="metrics">
  <div><small>الهدف الثاني</small><b>${fmt(r.t2)}</b></div>
  <div><small>الهدف الثالث</small><b>${fmt(r.t3)}</b></div>
  <div><small>المقاومة</small><b>${fmt(r.resistance)}</b></div>
 </div></div>

 <div class="section"><h4>🚀 مستويات الصعود والهبوط</h4>
 <div class="metrics">
  <div><small>القمة المرجعية</small><b>${fmt(r.topTarget)}</b></div>
  <div><small>القاع المرجعي</small><b>${fmt(r.bottomTarget)}</b></div>
  <div><small>الدعم الحالي</small><b>${fmt(r.support)}</b></div>
 </div>
 <p class="warning">هذه مستويات حسابية مستنتجة من نطاق السعر والتذبذب، وليست قمة أو قاعاً مضموناً.</p></div>

 <div class="section"><h4>🔬 أدلة التحليل</h4>
 <div class="metrics">
  <div><small>قوة الشراء</small><b class="goodtxt">${r.buy}/100</b></div>
  <div><small>قوة البيع</small><b class="badtxt">${r.sell}/100</b></div>
  <div><small>RSI</small><b>${r.rr.toFixed(1)}</b></div>
 </div>
 <div class="metrics">
  <div><small>توسع الحجم</small><b>${r.volRatio.toFixed(2)}x</b></div>
  <div><small>ضغط الشراء</small><b>${(r.takerRatio*100).toFixed(1)}%</b></div>
  <div><small>ضغط دفتر الأوامر</small><b>${(r.depthRatio*100).toFixed(1)}%</b></div>
 </div>
 <ul>${r.reasons.map(x=>'<li>'+x+'</li>').join('')||'<li>لا توجد أدلة كافية</li>'}</ul></div>

 <p class="warning">بيانات تدفق الصفقات ودفتر الأوامر تبدأ عند تشغيل المراقبة، ولا تمثل تاريخاً كاملاً قبل الاتصال. لا تستخدم الإشارة وحدها للدخول بأموال حقيقية.</p>
 <button class="primary" id="refreshReport">تحديث التحليل</button>`;

 $('refreshReport').onclick=async()=>{
  $('refreshReport').disabled=true;
  try{
   const fresh=await scanOne(symbol,$('tf').value);
   const i=results.findIndex(x=>x.symbol===symbol);
   if(i>=0)results[i]=fresh;
   render();
   await openReport(symbol);
  }catch(e){alert(e.message)}
 };
}

$('analyze').onclick=async()=>{
 const s=$('search').value.trim();
 if(!s){$('status').textContent='اكتب رمز العملة أولاً';return}
 $('analyze').disabled=true;
 $('status').textContent='جاري تحليل '+s;
 try{
  const r=await scanOne(s,$('tf').value);
  const i=results.findIndex(x=>x.symbol===r.symbol);
  if(i>=0)results[i]=r;else results.unshift(r);
  checkTransition(r);
  render();
  startCandidateSocket();
  $('status').textContent='اكتمل تحليل '+r.symbol;
  await openReport(r.symbol);
 }catch(e){
  $('status').textContent='تعذر التحليل: '+e.message;
 }finally{$('analyze').disabled=false}
};

$('search').addEventListener('keydown',e=>{
 if(e.key==='Enter')$('analyze').click();
});
$('scan').onclick=scanMarket;
$('filters').onclick=e=>{
 const b=e.target.closest('button[data-f]');
 if(!b)return;
 selected=b.dataset.f;
 document.querySelectorAll('#filters button').forEach(x=>
  x.classList.toggle('active',x===b));
 render();
};
$('close').onclick=()=>$('modal').style.display='none';
$('modal').onclick=e=>{
 if(e.target===$('modal'))$('modal').style.display='none';
};
$('notify').onclick=async()=>{
 if(!('Notification'in window)){
  alert('المتصفح لا يدعم إشعارات الهاتف');
  return;
 }
 const p=await Notification.requestPermission();
 alert(p==='granted'?'تم تفعيل الإشعارات':'لم يتم السماح بالإشعارات');
};

(async()=>{
 try{
  await loadUniverse();
  startTickerSocket();
  $('status').textContent='تم الاتصال. اضغط ابدأ صيد جميع العقود.';
  // تحديث الفحص كل 3 دقائق عند بدء المسح الأول
  setInterval(()=>{
   if(!scanning&&results.length)scanMarket();
  },180000);
 }catch(e){
  $('connection').textContent='● تعذر الاتصال';
  $('status').textContent='تحقق من الإنترنت أو افتح الصفحة عبر متصفح يسمح بالاتصال.';
 }
})();
</script>
</body>
</html>
